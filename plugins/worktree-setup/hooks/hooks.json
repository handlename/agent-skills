{
  "description": "Set up linked git worktrees at session start",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/setup-worktree.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
